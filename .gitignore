# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
.venv*

# User Local LLM Config & Keys (Never commit!)
llm_config.json
*.key
*.token
.env
.env.*

# Media Assets & Generated Artifacts
output/
uploads/
*.mp4
*.mov
*.wav
*.m4a
*.mp3
*.srt
*.vtt

# Allow custom voice templates & reference samples
!custom_voice/*.wav
!custom_voice/*.json

# Model weights & Checkpoints (downloaded automatically on demand)
*.safetensors
*.ckpt
*.pth

# Logs & Temp
*.log
*.tmp
