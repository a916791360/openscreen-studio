# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
.venv*

# User Local LLM Config & Keys (Never commit!)
llm_config.json
*.key
*.token
.env
.env.*

# User Local Custom Voice Config & Audio
custom_voice/voices.json
custom_voice/*.wav
custom_voice/*.m4a
custom_voice/*.mp3

# Media Assets & Generated Artifacts
output/
uploads/
*.mp4
*.mov
*.wav
*.m4a
*.mp3
*.srt
*.vtt

# Allow custom voice templates & documentation
!custom_voice/voices.example.json
!custom_voice/README.md
!custom_voice/.gitkeep

# Model weights & Checkpoints (downloaded automatically on demand)
*.safetensors
*.ckpt
*.pth

# Logs & Temp
*.log
*.tmp
